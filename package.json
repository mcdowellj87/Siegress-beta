{
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-dist.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:mac": "npm run desktop:build && electron-builder --mac --arm64 --publish never",
    "desktop:mac:intel": "npm run desktop:build && electron-builder --mac --x64 --publish never",
    "desktop:win": "npm run desktop:build && electron-builder --win --x64 --publish never",
    "desktop:linux": "npm run desktop:build && electron-builder --linux --x64 --publish never",
    "test:desktop": "node --test desktop/*.test.cjs",
    "desktop:smoke": "electron . --smoke-test",
    "test:physics": "node --test scripts/robot-physics.test.mjs"
  },
  "devDependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pngjs": "7.0.0",
    "@openai/sites-vite-plugin": "latest",
    "vite": "latest"
  },
  "type": "module",
  "name": "siegress-beta",
  "version": "0.1.0",
  "description": "Siegress \u2014 an illustrated exploration game",
  "author": "Siegress",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.siegress.beta",
    "productName": "Siegress Beta",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/asset-path.cjs",
      "dist-desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "maintainer": "Siegress"
    }
  }
}
